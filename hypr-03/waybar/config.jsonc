{
  "layer": "top",
  "position": "top",
  "height": 34,
  "margin-top": 8,
  "margin-left": 10,
  "margin-right": 10,
  "spacing": 0,
  "modules-left": ["custom/arch", "hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": [
    "tray",
    "custom/sep",
    "pulseaudio",
    "custom/sep2",
    "custom/power",
  ],
  "custom/arch": {
    "format": "󰣇",
    "tooltip": false,
  },
  "hyprland/workspaces": {
    "format": "{id}",
    "on-click": "activate",
    "sort-by-number": true,
    "persistent-workspaces": { "*": 5 },
  },
  "clock": {
    "format": "{:%H:%M   %a %d %b}",
    "interval": 1,
    "tooltip-format": "<big>{:%A %d %B %Y}</big>",
  },
  "tray": { "icon-size": 16, "spacing": 8 },
  "custom/network": {
    "exec": "~/.config/hypr3/waybar/scripts/network-vpn.sh",
    "return-type": "json",
    "restart-interval": 5,
    "on-click": "~/.config/hypr3/waybar/scripts/wifi-settings.sh",
  },
  "custom/battery": {
    "exec": "~/.config/hypr3/waybar/scripts/battery-status.sh",
    "return-type": "json",
    "restart-interval": 5,
  },
  "pulseaudio": {
    "format": "{icon}",
    "format-muted": "󰝟",
    "format-icons": ["󰕿", "󰖀", "󰕾"],
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-click-right": "pavucontrol",
  },
  "custom/brightness": {
    "format": "󰃠",
    "tooltip": false,
    "on-click": "brightnessctl set 5%+",
    "on-click-right": "brightnessctl set 5%-",
  },
  "custom/power": {
    "format": "⏻",
    "on-click": "~/.config/hypr3/scripts/Wlogout.sh",
    "tooltip": false,
  },
  "custom/sep": { "format": "|", "tooltip": false },
  "custom/sep2": { "format": "|", "tooltip": false },
}
