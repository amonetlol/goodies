// waybar FULL-MIN (base atrskv/dotfiles) — tema Base2Tone Space (Gogh); cores em colors.css
{
  "layer": "top",
  "position": "top",
  "height": 44,
  "spacing": 0,
  "margin-top": 13,
  "margin-bottom": 0,
  "margin-left": 13,
  "margin-right": 13,
  "modules-left": ["niri/workspaces"],
  "modules-center": ["custom/clima", "memory", "cpu"],
  "modules-right": ["wireplumber", "custom/relogio", "network", "custom/powermenu"],
  "niri/workspaces": {
    "format": "{index}"
  },
  "custom/clima": {
    "exec": "$HOME/.config/waybar/scripts/clima.sh",
    "return-type": "json",
    "interval": 900,
    "tooltip": true
  },
  "memory": {
    "interval": 2,
    "format": "<span foreground='#EC7336'>\uefc5</span> <span foreground='#A1A1B5'>{used:0.1f}G</span>",
    "tooltip-format": "{used:0.1f} GiB / {total:0.1f} GiB ({percentage}%)"
  },
  "cpu": {
    "interval": 2,
    "format": "<span foreground='#EC7336'>\uf2db</span> <span foreground='#A1A1B5'>{usage}%</span>",
    "tooltip-format": "Carga: {load}\nUso: {usage}%"
  },
  "wireplumber": {
    "format": "{icon} <span foreground='#A1A1B5'>{volume}%</span>",
    "format-muted": "\udb81\udd81",
    "on-click": "pwvucontrol",
    "scroll-step": 5,
    "max-volume": 100,
    "format-icons": ["\uf026", "\uf027", "\uf028"]
  },
  "custom/relogio": {
    "exec": "$HOME/.config/waybar/scripts/relogio.py '%a, %d/%m  %H:%M'",
    "return-type": "json",
    "interval": 30,
    "tooltip": true
  },
  "network": {
    "format-ethernet": "󰀂",
    "format-wifi": " ",
    "format-disconnected": "<span foreground='#F37B3F'>󰖪</span>",
    "tooltip-format": "{ipaddr}",
    "on-click": "nm-connection-editor"
  },
  "custom/powermenu": {
    "format": "\u23fb",
    "on-click": "wlogout",
    "tooltip": false
  }
}
