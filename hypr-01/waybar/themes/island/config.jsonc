{
    "layer": "top",
    "position": "top",
    "mode": "dock",
    "exclusive": true,
    "passthrough": false,
    "gtk-layer-shell": true,
    "height": 44,
    "margin-top": 10,
    "margin-bottom": 0,
    "margin-left": 100,
    "margin-right": 100,
    
    "modules-left": [
        "custom/launcher",
        "hyprland/workspaces"
    ],
    
    "modules-center": [
        "clock"
    ],
    
    "modules-right": [
        "tray",
        "pulseaudio",
        "network",
        "battery",
        "custom/updates",
        "custom/power"
    ],

    // ── Modules ─────────────────────────────────

    "custom/launcher": {
        "format": "󰣇",
        "on-click": "rofi -no-config -show drun -show-icons -theme \"$ROFI_DIR/active-launcher.rasi\"",
        "tooltip": false
    },

    "hyprland/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "format-icons": {
            "active": "",
            "default": ""
        },
        "persistent-workspaces": {
            "*": 4
        }
    },

    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month"
        }
    },

    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "󰖁",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pavucontrol"
    },

    "network": {
        "interval": 10,
        "format-wifi": "󰤨",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰤭",
        "on-click": "\"$WAYBAR_DIR/scripts/wifi-menu.sh\""
    },

    "battery": {
        "bat": "BAT0",
        "adapter": "ADP0",
        "interval": 60,
        "states": {
            "good": 80,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}",
        "format-charging": "󰂄",
        "format-plugged": "󰂄",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    },

    "custom/power": {
        "format": "⏻",
        "on-click": "\"$WAYBAR_DIR/scripts/power-menu.sh\"",
        "tooltip": false
    },

    "custom/updates": {
    "format": "󰚰  {}",
    "escape": true,
    "return-type": "json",
    "exec": "\"$WAYBAR_DIR/scripts/updates.sh\"",
    "interval": 3600,
    "on-click": "foot -e yay -Syu; pkill -RTMIN+8 waybar",
    "signal": 8
},
}
