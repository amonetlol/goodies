{
    "include": [
        "\"$WAYBAR_DIR/modules.jsonc\""
    ],
    "layer": "top",
    "position": "top",
    "height": 42,
    "margin-top": 8,
    "margin-bottom": 0,
    "margin-left": 4,
    "margin-right": 4,
    "spacing": 0,
    "gtk-layer-shell": true,

    "modules-left": [
        "custom/launcher",
        "hyprland/workspaces"
    ],
    
    "modules-center": [
        "clock"
    ],
    
    "modules-right": [
        "pulseaudio",
        "network",
        "battery",
        "custom/power"
    ],

    "custom/launcher": {
        "format": "▶",
        "on-click": "rofi -no-config -show drun -show-icons -theme \"$ROFI_DIR/active-launcher.rasi\"",
        "tooltip": false
    },

    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "all-outputs": true,
        "orientation": "horizontal"
    },

    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>"
    }
}
