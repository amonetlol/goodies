{
  "include": ["\"$WAYBAR_DIR/modules.jsonc\""],
  "layer": "top",
  "position": "top",
  "height": 34,
  "margin-top": 3,
  "margin-bottom": 0,
  "margin-right": 8,
  "margin-left": 8,
  "spacing": 2,
  "gtk-layer-shell": true,
  "modules-left": ["custom/launcher", "hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["pulseaudio", "network", "battery", "tray", "custom/power"],
  "custom/launcher": {
    "format": "󰣇",
    "on-click": "rofi -no-config -show drun -show-icons -theme \"$ROFI_DIR/active-launcher.rasi\"",
    "tooltip": false,
  },
  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "orientation": "horizontal",
    "all-outputs": true,
    "persistent-workspaces": {
      "*": 5,
    },
  },
  "clock": {
    "format": "{:%H:%M}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
  },
  "fixed-center": true,
}
