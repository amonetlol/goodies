{
  "layer": "top",
  "position": "top",
  "mode": "dock",
  "exclusive": true,
  "passthrough": false,
  "gtk-layer-shell": true,
  "height": 30,
  "margin-top": 0,
  "margin-bottom": 0,
  "margin-left": 0,
  "margin-right": 0,

  "modules-left": ["hyprland/workspaces"],

  "modules-center": ["clock"],

  "modules-right": [
    "tray",
    "pulseaudio",
    "bluetooth",
    "network",
    "battery",
    "custom/updates",
    "custom/power",
  ],

  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "disable-scroll": true,
    "all-outputs": true,
    "active-only": false,
    "persistent-workspaces": {
      "*": 5,
    },
  },

  "clock": {
    "locale": "pt_BR.UTF-8",
    "format": "{:L%A %H:%M}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
    },
  },

  "pulseaudio": {
    "format": "{volume}% {icon}",
    "format-muted": "0% 󰖁",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"],
    },
    "on-click": "pavucontrol",
  },

  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "󰂲",
    "format-connected": "󰂯",
    "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
    "on-click": "\"$WAYBAR_DIR/scripts/bluetooth-menu.sh\"",
  },

  "network": {
    "interval": 10,
    "format-wifi": "󰤨",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤭",
    "on-click": "\"$WAYBAR_DIR/scripts/wifi-menu.sh\"",
  },

  "battery": {
    "bat": "BAT0",
    "adapter": "ADP0",
    "interval": 60,
    "states": {
      "good": 80,
      "warning": 30,
      "critical": 15,
    },
    "format": "{capacity}% {icon}",
    "format-charging": "{capacity}% 󰂄",
    "format-plugged": "{capacity}% 󰂄",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
  },

  "custom/updates": {
    "format": "󰚰  {}",
    "escape": true,
    "return-type": "json",
    "exec": "\"$WAYBAR_DIR/scripts/updates.sh\"",
    "interval": 3600,
    "on-click": "foot -e yay -Syu; pkill -RTMIN+8 waybar",
    "signal": 8,
  },

  "custom/power": {
    "format": "⏻",
    "on-click": "\"$WAYBAR_DIR/scripts/power-menu.sh\"",
    "tooltip": false,
  },

  "tray": {
    "icon-size": 16,
    "spacing": 8,
  },
}
