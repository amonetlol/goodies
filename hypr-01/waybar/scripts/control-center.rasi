/* Control Center: painel compacto, cores do tema e estados na mesma linha. */
@import "../../rofi/colors.rasi"
* {
    background-color: transparent;
    text-color: @foreground;
    font: "JetBrainsMono Nerd Font 11";
}
window {
    width: 560px;
    location: center;
    anchor: center;
    background-color: @background;
    border: 2px;
    border-color: @selected;
    border-radius: 24px;
    padding: 16px;
}
mainbox {
    children: [ inputbar, message, listview ];
    spacing: 12px;
}
inputbar {
    children: [ prompt ];
    background-color: @background-alt;
    border-radius: 14px;
    padding: 16px;
}
prompt {
    text-color: @selected;
    font: "JetBrainsMono Nerd Font Bold 14";
}
message { padding: 0px 8px; }
textbox { text-color: @foreground; }
listview {
    columns: 1;
    lines: 5;
    fixed-height: false;
    dynamic: true;
    scrollbar: false;
    spacing: 8px;
}
element {
    children: [ element-text ];
    background-color: @background-alt;
    text-color: @foreground;
    padding: 18px 16px;
    border-radius: 14px;
}
element selected.normal {
    background-color: @selected;
    text-color: @background;
}
element-text {
    text-color: inherit;
    background-color: transparent;
    vertical-align: 0.5;
}
