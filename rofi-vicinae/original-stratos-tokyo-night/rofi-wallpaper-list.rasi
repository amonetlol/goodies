/* StratOS tokyo-night · wallpaper picker (lista)
 * Uso tipico:
 *   ls ~/Pictures/Wallpapers | rofi -dmenu -i -p "Wallpaper" -theme rofi-wallpaper-list.rasi
 */
configuration {
    modi:                       "dmenu";
    show-icons:                 false;
    font:                       "JetBrainsMono NF 15";
    disable-history:            true;
    hide-scrollbar:             true;
}

@import "colors.rasi"

window {
    width:              520px;
    height:             420px;
    border:             3px;
    border-color:       @border-color;
    border-radius:      10px;
    background-color:   @background;
    padding:            12px;
}

mainbox {
    spacing:            10px;
    background-color:   transparent;
    children:           [ inputbar, message, listview ];
}

inputbar {
    spacing:            10px;
    padding:            12px 14px;
    border-radius:      8px;
    background-color:   @background-alt;
    text-color:         @foreground;
    children:           [ prompt, entry ];
}

prompt {
    text-color:         @magenta;
    padding:            0px 10px 0px 0px;
}

entry {
    placeholder:        "Filter wallpapers…";
    placeholder-color:  @comment;
    text-color:         @foreground;
    background-color:   transparent;
}

message {
    padding:            6px 4px 2px 4px;
    background-color:   transparent;
    text-color:         @comment;
}

textbox {
    background-color:   transparent;
    text-color:         @comment;
}

listview {
    columns:            1;
    lines:              9;
    spacing:            3px;
    cycle:              true;
    dynamic:            true;
    scrollbar:          false;
    layout:             vertical;
    background-color:   transparent;
}

element {
    padding:            10px 12px;
    spacing:            10px;
    border-radius:      8px;
    background-color:   transparent;
    text-color:         @foreground;
    orientation:        horizontal;
    children:           [ element-text ];
}

element-text {
    background-color:   transparent;
    text-color:         inherit;
    vertical-align:     0.5;
}

element normal.normal,
element alternate.normal {
    background-color:   transparent;
    text-color:         @foreground;
}

element selected.normal {
    background-color:   @selected-background;
    text-color:         @selected-foreground;
}
