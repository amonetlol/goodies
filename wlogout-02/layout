{
    "label": "lock",
    "action": "bash \"$VORA_WLOGOUT_DIR/lock\"",
    "text": "Lock",
    "keybind": "l"
}
{
    "label" : "logout",
    "action" : "hyprctl eval 'hl.dispatch(hl.dsp.exit())'",
    "text" : "Logout",
    "keybind" : "e"
}
{
    "label" : "suspend",
    "action" : "systemctl suspend",
    "text" : "Suspend",
    "keybind" : "u"
}
{
    "label" : "reboot",
    "action" : "systemctl reboot",
    "text" : "Reboot",
    "keybind" : "r"
}
{
    "label" : "shutdown",
    "action" : "systemctl poweroff",
    "text" : "Shutdown",
    "keybind" : "s"
}
