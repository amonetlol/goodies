@import "~/.config/rofi/rofi-top-01/outtheme.rasi"
configuration { show-icons: true; }
window { width: 1120px; }
listview {
    require-input: false;
    columns: 4; lines: 3; spacing: 12px;
    fixed-height: true; fixed-columns: true;
    layout: vertical; flow: horizontal;
}
element { orientation: vertical; spacing: 8px; padding: 10px; children: [ element-icon, element-text ]; }
element-icon { size: 220px; padding: 0px; horizontal-align: 0.5; }
element-text { horizontal-align: 0.5; font: "Maple Mono NF 10"; }
